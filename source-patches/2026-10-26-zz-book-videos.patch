--- /dev/null
+++ b/lib/course-recommendations.ts
@@ -0,0 +1,54 @@
+import {reviewedBilibili} from './reviewed-course-links';
+import type {Course} from './learning-data';
+export type VideoRecommendations={query:string;courses:Course[];statuses:Record<string,string>;checkedAt:string;retryAfterSeconds:number};
+export type VideoSearchOptions={fetcher?:typeof fetch;previous?:VideoRecommendations};
+const clean=(value:unknown)=>typeof value==='string'?value.replace(/<[^>]*>/g,'').replace(/&amp;/g,'&').replace(/&quot;/g,'"').replace(/&#39;|&apos;/g,"'").replace(/&lt;/g,'<').replace(/&gt;/g,'>').trim():'';
+const normalize=(s:string)=>s.normalize('NFKC').toLowerCase().replace(/第[一二三四五六七八九十\d]+版|第\s*\d+\s*版|\b\d+(?:st|nd|rd|th)\s+edition\b/gi,'').replace(/[《》\s\p{P}\p{S}]/gu,'');
+export function normalizeVideoQuery(value:unknown):string{if(typeof value!=='string'||!value.trim()||value.trim().length>160)throw new Error('书名需要为1–160字。');return value.trim().replace(/\s+/g,' ');}
+const translations:[RegExp,string][]=[[/生物化学|biochemistry/i,'biochemistry'],[/货币银行|货币金融|money and banking/i,'money and banking'],[/线性代数|linear algebra/i,'linear algebra'],[/微积分|高等数学|calculus/i,'calculus'],[/python/i,'python programming'],[/概率|统计|statistics/i,'probability statistics'],[/大学物理|physics/i,'physics'],[/计算机组成|computer architecture/i,'computer architecture'],[/世界历史|world history/i,'world history'],[/有机化学|organic chemistry/i,'organic chemistry']];
+export function englishVideoQuery(query:string):string{return translations.find(([p])=>p.test(query))?.[1]||query;}
+export function courseMatch(query:string,text:string):'book'|'subject'|null{
+ const q=normalize(query),t=normalize(text);if(q.length>=2&&t.includes(q))return 'book';
+ const translated=translations.find(([p])=>p.test(query))?.[1];if(translated){const words=translated.split(' ').filter(w=>!['programming','probability'].includes(w));if(words.length&&words.every(w=>new RegExp('\\b'+w+'\\b','i').test(text)))return 'subject';}
+ const chinese=q.replace(/[^\p{Script=Han}]/gu,'').replace(/教材|教程|基础|入门|课程|实践/g,'');
+ const grams=[...new Set(Array.from({length:Math.max(0,chinese.length-1)},(_,i)=>chinese.slice(i,i+2)))];
+ if(grams.length>=2&&grams.filter(g=>t.includes(g)).length>=Math.max(2,Math.ceil(grams.length*.65)))return 'subject';
+ const words=query.toLowerCase().match(/[a-z][a-z0-9+#]{2,}/g)||[];
+ return words.length&&words.every(w=>text.toLowerCase().includes(w))?'subject':null;
+}
+
+const youtubeCatalog=[{"subject": "biochemistry", "id": "KLb5CmPM7YY", "title": "12. Carbohydrates/Introduction to Membranes", "author": "MIT OpenCourseWare", "source": "https://ocw.mit.edu/courses/7-05-general-biochemistry-spring-2020/resources/lecture-12-carbohydrates-introduction-to-membranes/"}, {"subject": "calculus", "id": "_nbtaQtX6JA", "title": "Definition of the Derivative | MIT 18.01SC Single Variable Calculus, Fall 2010", "author": "MIT OpenCourseWare", "source": "https://ocw.mit.edu/courses/18-01sc-single-variable-calculus-fall-2010/pages/1.-differentiation/part-a-definition-and-basic-rules/session-1-introduction-to-derivatives/"}, {"subject": "python programming", "id": "xAcTmDO6NTI", "title": "Lecture 1: Introduction to CS and Programming Using Python", "author": "MIT OpenCourseWare", "source": "https://ocw.mit.edu/courses/6-100l-introduction-to-cs-and-programming-using-python-fall-2022/resources/6100l-lecture-1-version-2_mp4/"}, {"subject": "linear algebra", "id": "J7DzL2_Na80", "title": "1. The Geometry of Linear Equations", "author": "MIT OpenCourseWare", "source": "https://ocw.mit.edu/courses/18-06-linear-algebra-spring-2010/resources/lecture-1-the-geometry-of-linear-equations/"},{"subject":"money and banking","id":"fLBZb_v0ewM","title":"Money and Banking - Lecture 01","author":"Krassimir Petrov","source":"https://www.youtube.com/watch?v=fLBZb_v0ewM"}];
+const biliCatalog:[RegExp,string[]][]=[[/货币银行|货币金融|money and banking/i,['BV1LW4y187SV','BV1vJ411X7Cd']],[/动物生物化学|生物化学|biochemistry/i,['BV19o4y1y7DA','BV1FhPqzaEbd']],[/高等数学|高数|微积分|calculus/i,['BV1CAxaeHEeH']],[/线性代数|linear algebra/i,['BV1d7wAzsE8V']],[/概率|数理统计|probability|statistics/i,['BV1JXppejE8q']],[/python/i,['BV1qW4y1a7fU']]];
+const headers={'User-Agent':'ZhixueCourseLinks/1.0',Referer:'https://www.bilibili.com/'};
+async function readJson(fetcher:typeof fetch,url:URL,init:RequestInit={}){const response=await fetcher(url,{...init,signal:AbortSignal.timeout(7000),redirect:'error'});if(response.status===404||response.status===410)return {};if(!response.ok)throw new Error('platform_unavailable');return response.json() as Promise<Record<string,any>>;}
+async function biliDetail(query:string,id:string,fetcher:typeof fetch,checkedAt:string):Promise<Course|undefined>{
+ const url=new URL('https://api.bilibili.com/x/web-interface/view');url.searchParams.set('bvid',id);
+ let detail:Record<string,any>;try{detail=await readJson(fetcher,url,{headers});if(detail.code===-412||detail.code===-352)throw new Error('limited');}catch{const seed=reviewedBilibili.find(s=>s.id===id&&Date.now()-Date.parse(s.checkedAt)<30*86400000);if(!seed)return;detail={code:0,data:{bvid:id,title:seed.title,desc:seed.description,owner:{name:seed.author},reviewedAt:seed.checkedAt}};}const d=detail.data;
+ if(detail.code!==0||!d||d.bvid!==id||typeof d.title!=='string'||d.rights?.is_stein_gate===1)return;
+ const match=courseMatch(query,clean(d.title)+' '+clean(d.desc));if(!match)return;
+ return {id:'bili-'+id,title:clean(d.title),school:clean(d.owner?.name)||'B站创作者',teacher:clean(d.owner?.name)||'B站创作者',platform:'B站',language:'中文',url:'https://www.bilibili.com/video/'+id+'/',bvid:id,note:'同主题补充课程，不保证对应指定教材或版次；进入原站后可选择分集。',status:d.reviewedAt?'课程库已核对 · 播放以原站为准':'原站链接已核对',topics:[query],linkCheckedAt:d.reviewedAt||checkedAt,matchType:match};
+}
+async function bilibili(query:string,fetcher:typeof fetch,checkedAt:string):Promise<Course|undefined>{
+ const catalog=biliCatalog.find(([pattern])=>pattern.test(query))?.[1]||[];
+ // Known subjects can be resolved without relying on the rate-limited search endpoint.
+ for(const id of catalog){try{const course=await biliDetail(query,id,fetcher,checkedAt);if(course)return course;}catch{/* Try the next reviewed entry. */}}
+ const url=new URL('https://api.bilibili.com/x/web-interface/search/type');url.search=new URLSearchParams({search_type:'video',keyword:query+' 课程',page:'1',page_size:'10',order:'totalrank'}).toString();
+ const data=await readJson(fetcher,url,{headers});if(data.code!==0||!Array.isArray(data.data?.result))return;
+ const ids=[...new Set(data.data.result.filter((v:any)=>typeof v.bvid==='string'&&/^BV[\w]{10}$/.test(v.bvid)&&courseMatch(query,clean(v.title)+' '+clean(v.description))).map((v:any)=>v.bvid))].slice(0,3) as string[];
+ for(const id of ids){try{const course=await biliDetail(query,id,fetcher,checkedAt);if(course)return course;}catch{/* Broken links are never shown. */}}
+}
+async function youtube(query:string,fetcher:typeof fetch,checkedAt:string):Promise<Course|undefined>{
+ const subject=englishVideoQuery(query),seed=youtubeCatalog.find(s=>s.subject===subject);if(!seed)return;
+ const url=new URL('https://www.youtube.com/oembed');url.search=new URLSearchParams({url:'https://www.youtube.com/watch?v='+seed.id,format:'json'}).toString();
+ let data:Record<string,any>;let reviewed=false;try{data=await readJson(fetcher,url);}catch{if(Date.now()-Date.parse('2026-10-26T13:18:00Z')>=30*86400000)return;reviewed=true;data={type:'video',provider_name:'YouTube',author_name:seed.author,title:seed.title};}
+ if(data.type!=='video'||data.provider_name!=='YouTube'||data.author_name!==seed.author||!clean(data.title))return;
+ return {id:'youtube-'+seed.id,title:clean(data.title),school:seed.author,teacher:seed.author,platform:'YouTube',language:'英文',url:'https://www.youtube.com/watch?v='+seed.id,videoId:seed.id,official:seed.source,note:'按书名主题匹配的公开视频，作为补充参考，不保证对应指定教材或版次。',status:reviewed?'课程库已核对 · 同主题补充':'原站链接已核对 · 同主题补充',topics:[query],linkCheckedAt:reviewed?'2026-10-26T13:18:00Z':checkedAt,matchType:'subject'};
+}
+export async function recommendBookVideos(rawQuery:unknown,options:VideoSearchOptions={}):Promise<VideoRecommendations>{
+ const query=normalizeVideoQuery(rawQuery),fetcher=options.fetcher||fetch,checkedAt=new Date().toISOString();
+ const fresh=(platform:string)=>options.previous?.query===query?options.previous.courses.find(c=>c.platform===platform&&typeof c.linkCheckedAt==='string'&&Date.now()-Date.parse(c.linkCheckedAt)>=0&&Date.now()-Date.parse(c.linkCheckedAt)<86400000):undefined;
+ const settled=await Promise.allSettled([fresh('B站')?Promise.resolve(fresh('B站')):bilibili(query,fetcher,checkedAt),fresh('YouTube')?Promise.resolve(fresh('YouTube')):youtube(query,fetcher,checkedAt)]);
+ const courses:Course[]=[],statuses:Record<string,string>={};
+ ['B站','YouTube'].forEach((platform,i)=>{const result=settled[i];if(result.status==='fulfilled'&&result.value){courses.push(result.value);statuses[platform]=result.value.status.startsWith('课程库')?'已匹配课程库链接，最近核对：'+result.value.linkCheckedAt?.slice(0,10)+'。':'已匹配并核对原站视频链接。';}else statuses[platform]='暂未找到可核实的相关视频，或平台暂时无法访问。';});
+ return {query,courses,statuses,checkedAt,retryAfterSeconds:courses.length===2?86400:1800};
+}
