+import assert from 'node:assert/strict';
+import {recommendBookVideos,courseMatch} from '../lib/course-recommendations.ts';
+import {POST} from '../app/api/courses/route.ts';
+let calls=[];
+const transport=async(raw)=>{const u=new URL(raw);calls.push(u.href);
+ if(u.hostname==='api.bilibili.com'&&u.pathname.endsWith('/view'))return Response.json({code:0,data:{bvid:u.searchParams.get('bvid'),title:'南京农业大学-动物生物化学',desc:'动物生物化学课程',owner:{name:'公开课程'},stat:{like:99999}}});
+ if(u.hostname==='www.youtube.com'&&u.pathname==='/oembed')return Response.json({type:'video',provider_name:'YouTube',author_name:'MIT OpenCourseWare',title:'12. Carbohydrates/Introduction to Membranes'});
+ throw new Error('unexpected network');
+};
+const data=await recommendBookVideos('动物生物化学',{fetcher:transport});
+assert.equal(data.courses.length,2);assert.equal(new Set(data.courses.map(c=>c.platform)).size,2);
+assert.ok(data.courses.every(c=>c.linkCheckedAt&&!('likeCount' in c)&&!('viewCount' in c)));
+assert.ok(calls.every(u=>!u.includes('googleapis')&&!u.includes('key=')));
+assert.equal(data.courses[0].url,'https://www.bilibili.com/video/BV19o4y1y7DA/');
+const before=calls.length;await recommendBookVideos('动物生物化学',{fetcher:transport,previous:data});assert.equal(calls.length,before);
+const failed=await recommendBookVideos('完全未知的冷门教材',{fetcher:async()=>new Response(null,{status:412})});
+assert.equal(failed.courses.length,0);assert.ok(!JSON.stringify(failed).includes('search.bilibili.com'));
+assert.equal(courseMatch('动物生物化学','烹饪方法'),null);
+let checked=0;const partial=await recommendBookVideos('动物生物化学',{fetcher:async u=>{if(new URL(u).hostname==='www.youtube.com')return new Response(null,{status:404});checked++;return transport(u);}});
+assert.equal(partial.courses.length,1);assert.ok(checked>0);
+const wrongOwner=await recommendBookVideos('动物生物化学',{fetcher:async u=>new URL(u).hostname==='www.youtube.com'?Response.json({type:'video',provider_name:'YouTube',author_name:'Other account',title:'unrelated'}):transport(u)});assert.equal(wrongOwner.courses.length,1);
+const r=await POST(new Request('https://local/api/courses',{method:'POST',body:JSON.stringify({query:'动物生物化学',youtubeKey:'must-not-use'})}),{COURSE_LOOKUP:async()=>data});assert.equal(r.status,200);assert.equal((await r.json()).courses.length,2);
+assert.equal((await POST(new Request('https://local/api/courses',{method:'POST',body:'{}'}))).status,400);
+console.log('Book recommendations: direct links, no API keys/likes, relevance, failed platforms, cache reuse and input validation passed');
