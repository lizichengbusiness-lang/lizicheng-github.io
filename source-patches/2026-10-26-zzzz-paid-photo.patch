+  if(file.type?!/^image\/(jpeg|pjpeg|png|webp)$/.test(file.type):!/^.+\.(jpe?g|png|webp)$/i.test(file.name))throw new Error('请选择JPG、PNG或WebP图片。');
+  let source=null,dispose=()=>{};
+  try{
+   if(typeof createImageBitmap==='function'){try{source=await createImageBitmap(file);if(!source.width||!source.height){source.close();source=null;}else dispose=()=>source.close();}catch{source=null;}}
