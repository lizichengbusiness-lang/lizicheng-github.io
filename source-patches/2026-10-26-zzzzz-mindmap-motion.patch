+/* Geometry and camera share a frame clock, so curves stay attached while focusing. */
+.mindmap.motion-ready{border-radius:18px;box-shadow:0 8px 30px #24475a08;border-color:#d6e4e5}.motion-ready .mindmap-toolbar{border-radius:18px 18px 0 0;background:linear-gradient(105deg,#fff,#f7fbfa)}.motion-ready .mindmap-world{transition:none;will-change:transform}.motion-ready .mindmap-viewport{background-color:#f8fbfa;background-image:radial-gradient(ellipse at 50% 35%,#e5f1ed80,transparent 65%),radial-gradient(#8caaa72b .75px,transparent .75px);background-size:auto,24px 24px}.motion-ready foreignObject{overflow:visible}.motion-ready .mind-node{transition:background-color 160ms,border-color 160ms,box-shadow 160ms;box-shadow:0 4px 12px #2148460a}.motion-ready .mind-node:hover{box-shadow:0 7px 18px #21484618}.motion-ready .mind-node:disabled{opacity:1;cursor:default}.motion-ready .mind-book.central{background:linear-gradient(135deg,#183c49,#2b6065);border-color:#244e58;box-shadow:0 10px 30px #173f4b22}.motion-ready .mind-topic.central{box-shadow:0 0 0 5px color-mix(in srgb,var(--tone),transparent 91%),0 8px 22px #20464c12}.motion-ready .map-heading-copy{animation:map-copy-in 180ms ease-out}.map-level-badge{display:block;width:fit-content;font-size:9px;letter-spacing:1px;padding:3px 7px;border:1px solid #d5e5df;border-radius:5px;background:#edf6f1;color:#4c7b6a;margin-bottom:7px}.motion-ready .map-zoom{border-radius:12px;padding:6px;box-shadow:0 5px 18px #27463c12;background:#fffffff2}.motion-ready .map-edge{stroke-linecap:round}.motion-ready .map-canvas-hint{background:#ffffffc9;padding:6px 10px;border-radius:7px;bottom:20px;color:#607e79}.motion-ready .map-concept-detail{animation:map-copy-in 180ms ease-out}.motion-ready .map-heading strong{display:block}.motion-ready .map-footer{background:#fbfdfc;border-radius:0 0 18px 18px}@keyframes map-copy-in{from{opacity:.3;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.motion-ready .map-heading-copy,.motion-ready .map-concept-detail{animation:none}.motion-ready .mind-node{transition:none}.motion-ready .mindmap-world{will-change:auto}}
diff --git a/tests/mindmap-motion.test.mjs b/tests/mindmap-motion.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/mindmap-motion.test.mjs
@@ -0,0 +1,16 @@
+import assert from 'node:assert/strict';
+import {sampleTopics} from '../lib/learning-data.ts';
+import {makeMindmap} from '../lib/mindmap-layout.ts';
+import {fitMapCamera,settledMapScene,planMapTransition,sampleMapTransition,interpolateCamera,easeMap,edgeIdentity} from '../lib/mindmap-motion.ts';
+const book=makeMindmap(sampleTopics,{kind:'book'},'测试书籍',false),chapter=makeMindmap(sampleTopics,{kind:'chapter',id:sampleTopics[0].group},'测试书籍',false),topic=makeMindmap(sampleTopics,{kind:'topic',id:sampleTopics[0].id},'测试书籍',false);
+const start=settledMapScene(book,fitMapCamera(book.nodes,1000,620)),plan=planMapTransition(start,chapter);
+for(const progress of [0,.1,.5,.9,1]){const frame=sampleMapTransition(plan,progress),ids=new Set(frame.nodes.map(n=>n.id));assert.equal(ids.size,frame.nodes.length);assert.ok(frame.nodes.every(n=>Number.isFinite(n.x)&&Number.isFinite(n.y)&&n.width>0&&n.height>0&&n.opacity>=0&&n.opacity<=1));assert.ok(frame.edges.every(e=>ids.has(e.from)&&ids.has(e.to)));}
+const first=sampleMapTransition(plan,0);for(const node of start.nodes){const n=first.nodes.find(n=>n.id===node.id);assert.equal(n.x,node.x);assert.equal(n.y,node.y);assert.equal(n.opacity,node.opacity);}
+const end=sampleMapTransition(plan,1);for(const node of chapter.nodes){const n=end.nodes.find(n=>n.id===node.id);assert.equal(n.x,node.x);assert.equal(n.y,node.y);assert.equal(n.width,node.width);assert.equal(n.opacity,1);}
+const middle=sampleMapTransition(plan,.4),retarget=sampleMapTransition(planMapTransition({...middle,camera:start.camera},topic),0);
+for(const node of middle.nodes.filter(n=>n.opacity>.001)){const n=retarget.nodes.find(n=>n.id===node.id);assert.equal(n.x,node.x);assert.equal(n.y,node.y);assert.equal(n.opacity,node.opacity,'Rapid navigation starts from the currently visible frame');}
+assert.ok(sampleMapTransition(plan,.7).nodes.filter(n=>n.exiting).every(n=>n.opacity===0));
+for(const layout of [book,chapter,topic])for(const size of [[390,480],[1000,620]]){const camera=fitMapCamera(layout.nodes,...size);assert.ok(camera.k>0&&Number.isFinite(camera.x));for(const n of layout.nodes){assert.ok(n.x*camera.k+camera.x>=0);assert.ok((n.x+n.width)*camera.k+camera.x<=size[0]);}}
+const from={x:0,y:10,k:1},to={x:200,y:30,k:2};assert.deepEqual(interpolateCamera(from,to,0),from);assert.deepEqual(interpolateCamera(from,to,1),to);assert.equal(easeMap(0),0);assert.equal(easeMap(1),1);
+assert.equal(new Set(topic.edges.map(edgeIdentity)).size,topic.edges.length);
+console.log('Mindmap motion: stable node identity, continuous retargeting, attached edges, fade-out, exact endpoints, and responsive fit passed');
