+import {mapBounds,type MapNode,type MapEdge,type MapLayout} from './mindmap-layout';
+export type MapCamera={x:number;y:number;k:number};
+export type MovingNode=MapNode&{opacity:number;exiting?:boolean};
+export type MovingEdge=MapEdge&{opacity:number;exiting?:boolean};
+export type MapScene={nodes:MovingNode[];edges:MovingEdge[];camera:MapCamera};
+export const edgeIdentity=(edge:MapEdge)=>`${edge.kind}:${edge.from}->${edge.to}`;
+export const easeMap=(t:number)=>{const n=Math.min(1,Math.max(0,t));return n*n*(3-2*n);};
+const mix=(a:number,b:number,t:number)=>a+(b-a)*t;
+export function interpolateCamera(a:MapCamera,b:MapCamera,t:number):MapCamera{return{x:mix(a.x,b.x,t),y:mix(a.y,b.y,t),k:mix(a.k,b.k,t)};}
+export function fitMapCamera(nodes:MapNode[],width:number,height:number):MapCamera{
+ const bounds=mapBounds(nodes),k=Math.max(.02,Math.min(1.32,(Math.max(1,width)-28)/bounds.width,(Math.max(1,height)-58)/bounds.height));
+ return{k,x:(width-bounds.width*k)/2-bounds.x*k,y:(height-bounds.height*k)/2-bounds.y*k};
+}
+export function settledMapScene(layout:MapLayout,camera:MapCamera):MapScene{return{nodes:layout.nodes.map(n=>({...n,opacity:1})),edges:layout.edges.map(e=>({...e,opacity:1})),camera};}
+export function planMapTransition(before:MapScene,layout:MapLayout){
+ const previous=new Map(before.nodes.map(n=>[n.id,n])),next=new Map(layout.nodes.map(n=>[n.id,n]));
+ const root=layout.nodes.find(n=>n.central)||layout.nodes[0],origin=(root&&previous.get(root.id))||before.nodes.find(n=>n.central&&!n.exiting)||root;
+ const collapse=(node:MapNode,anchor:MapNode|undefined)=>({...node,x:(anchor?anchor.x+anchor.width/2:node.x+node.width/2)-node.width*.44,y:(anchor?anchor.y+anchor.height/2:node.y+node.height/2)-node.height*.44,width:node.width*.88,height:node.height*.88,opacity:0});
+ const nodes=layout.nodes.map(node=>({from:previous.get(node.id)||collapse(node,origin),to:{...node,opacity:1},exiting:false}));
+ for(const node of before.nodes)if(!next.has(node.id)&&node.opacity>.001)nodes.push({from:node,to:collapse(node,root),exiting:true});
+ const oldEdges=new Map(before.edges.map(e=>[edgeIdentity(e),e])),keys=new Set(layout.edges.map(edgeIdentity));
+ const edges=layout.edges.map(edge=>({from:oldEdges.get(edgeIdentity(edge))?.opacity||0,to:1,edge,exiting:false}));
+ for(const edge of before.edges)if(!keys.has(edgeIdentity(edge))&&edge.opacity>.001)edges.push({from:edge.opacity,to:0,edge,exiting:true});
+ return{nodes,edges};
+}
+export function sampleMapTransition(plan:ReturnType<typeof planMapTransition>,progress:number){
+ const p=Math.min(1,Math.max(0,progress)),t=easeMap(p);
+ return{nodes:plan.nodes.map(({from,to,exiting})=>({...to,x:mix(from.x,to.x,t),y:mix(from.y,to.y,t),width:mix(from.width,to.width,t),height:mix(from.height,to.height,t),opacity:mix(from.opacity,to.opacity,easeMap(Math.min(1,p*(exiting?1.7:1)))),exiting})),edges:plan.edges.map(({edge,from,to,exiting})=>({...edge,opacity:mix(from,to,easeMap(Math.min(1,p*(exiting?1.7:1)))),exiting}))};
+}
