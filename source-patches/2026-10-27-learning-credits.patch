+'use client';
+import {useEffect,useRef,useState} from 'react';
+import {MessageCircle,GraduationCap,ArrowUpRight,LoaderCircle} from 'lucide-react';
+import type {Lesson} from '@/lib/curriculum';
+import {LEARNING_BACKEND,PASS_STORAGE,parsePass,storedPass,storePass,learningApi,courseExcerpt,type LearningPass,type WalletView,type PracticeCall} from '@/lib/learning-client';
+import LessonText from './LessonText';
+import './LearningPractice.css';
+export default function LearningPractice({book,topic,lesson}:{book:string;topic:string;lesson:Lesson}){
+ const [pass,setPass]=useState<LearningPass|null>(null),[wallet,setWallet]=useState<WalletView|null>(null),[code,setCode]=useState(''),[question,setQuestion]=useState(''),[difficulty,setDifficulty]=useState('基础'),[busy,setBusy]=useState(false),[error,setError]=useState(''),[message,setMessage]=useState(''),[older,setOlder]=useState<PracticeCall[]>([]),[more,setMore]=useState(true);
+ const lock=useRef(false),mounted=useRef(true);
+ useEffect(()=>{mounted.current=true;return()=>{mounted.current=false;};},[]);
+ async function refresh(p=pass){if(!p)return;const w=await learningApi('',p);if(mounted.current){setWallet(w);setOlder([]);setMore(true);}}
+ async function activate(p:LearningPass){const data=await learningApi<{sessionToken:string;wallet:WalletView}>('/session',p,{});p={...p,session:data.sessionToken};try{storePass(p);}catch{setError('浏览器无法保存凭证，请立即复制凭证并保持本页打开。');}if(mounted.current){setPass(p);setWallet(data.wallet);setCode('');setOlder([]);setMore(true);setMessage('次数已恢复；此前设备的提问会话已失效。');}}
+ useEffect(()=>{const p=storedPass();setPass(p);if(p)refresh(p).catch(e=>setError(e.message));if(location.hash.startsWith('#learning-pass=')){const raw=location.hash.slice(15);history.replaceState(null,'',location.pathname+location.search);const imported=parsePass(decodeURIComponent(raw));if(imported)activate(imported).catch(e=>setError(e.message));}
+ const sync=(e:StorageEvent)=>{if(e.key===PASS_STORAGE){const next=storedPass();setPass(next);if(next)refresh(next).catch(e=>setError(e.message));else setWallet(null);}};window.addEventListener('storage',sync);return()=>window.removeEventListener('storage',sync);},[]);
+ function purchase(){const u=new URL('/practice',LEARNING_BACKEND);if(pass)u.hash='pass='+encodeURIComponent(pass.id+':'+pass.token);window.open(u.href,'_blank','noopener,noreferrer');}
+ async function submit(kind:'question'|'quiz'){
+ if(lock.current||!pass)return;lock.current=true;setBusy(true);setError('');setMessage('');
+ try{const data=await learningApi<{call:PracticeCall;wallet:WalletView}>('/calls',pass,{requestId:crypto.randomUUID(),kind,difficulty,book,topic,context:courseExcerpt(lesson),question:kind==='question'?question.trim():''});if(!mounted.current)return;setWallet(data.wallet);setOlder([]);setMore(true);if(data.call.status==='done'){setMessage('已完成，本次扣除1次。');if(kind==='question')setQuestion('');}else if(data.call.status==='pending')setMessage('请求仍在处理中，请稍后刷新记录；无需再次提交。');else setError(data.call.error||'本次未完成，次数已退回。');}
+ catch(e){if(mounted.current){setError((e instanceof Error?e.message:'网络异常')+' 如未收到结果，请先刷新记录确认状态。');try{await refresh(pass);}catch{}}}finally{lock.current=false;if(mounted.current)setBusy(false);}
+ }
+ async function loadOlder(){if(!pass||busy)return;setBusy(true);try{const all=[...(wallet?.history||[]),...older],cursor=all.at(-1)?.cursor;if(!cursor){setMore(false);return;}const data=await learningApi<{history:PracticeCall[]}>('/calls?before='+cursor,pass);setOlder(v=>[...v,...data.history]);setMore(data.history.length===50);}catch(e){setError((e as Error).message);}finally{setBusy(false);}}
+ const calls=[...(wallet?.history||[]),...older].filter(c=>c.book===book&&c.topic===topic);
+ return <section className="learning-practice" aria-label="课后提问与练习"><div className="practice-heading"><div><span className="practice-eyebrow">把这一节，学得更扎实</span><h3><MessageCircle size={21}/>课后提问与练习</h3></div><span className="practice-price">¥0.09<span> / 次</span></span></div><p className="practice-intro">围绕本节课程答疑，或生成5道附答案的练习题。两种功能共用次数，成功一次扣1次；每次独立回答，不提供无限续写。</p>
+ <div className="practice-wallet"><strong>{wallet?`可用 ${wallet.balance} 次${wallet.pending?' · 1次处理中':''}`:'无需注册，凭次数恢复凭证使用'}</strong><div><button type="button" className="primary-button" onClick={purchase}>购买次数<ArrowUpRight size={15}/></button>{pass&&<button type="button" className="quiet-button" disabled={busy} onClick={()=>refresh().then(()=>setMessage('余额和记录已刷新。')).catch(e=>setError(e.message))}>刷新余额与记录</button>}</div></div>
+ <details className="practice-restore"><summary>已有次数？恢复凭证 / 换设备使用</summary><p>次数保存在服务端。笔记和学习进度仍在本浏览器；恢复凭证可访问次数及问答记录，请勿分享。在新设备启用后，旧设备不能继续提问。</p><form onSubmit={e=>{e.preventDefault();const p=parsePass(code);if(!p){setError('请完整粘贴“LW开头的编号:访问凭证”。');return;}setBusy(true);activate(p).catch(e=>setError(e.message)).finally(()=>setBusy(false));}}><label>次数恢复凭证<textarea rows={2} value={code} onChange={e=>setCode(e.target.value)} required autoComplete="off" spellCheck={false}/></label><button className="quiet-button" disabled={busy}>恢复并在本设备启用</button></form>{pass&&<><p>当前凭证（请自行保存）：</p><code className="practice-code">{pass.id}:{pass.token}</code><button className="quiet-button" type="button" onClick={()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([pass.id+':'+pass.token],{type:'text/plain'}));a.download='知学图谱-次数恢复凭证.txt';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);}}>下载凭证</button></>}</details>
+ {error&&<p className="practice-error" role="alert">{error}</p>}{message&&<p className="practice-message" role="status">{message}</p>}
+ <div className="practice-tools"><form onSubmit={e=>{e.preventDefault();submit('question');}}><h4><MessageCircle size={17}/>这节课哪里没弄懂？</h4><label className="sr-only" htmlFor="practice-question">本节课程问题</label><textarea id="practice-question" placeholder="例如：能用这节课的例子再解释一下这个概念吗？" maxLength={600} rows={4} value={question} onChange={e=>setQuestion(e.target.value)} disabled={busy}/><div className="practice-form-footer"><small>{question.length}/600字</small><button className="primary-button" disabled={busy||!wallet||wallet.balance<1||wallet.pending>0||!question.trim()}>{busy?<LoaderCircle className="spin" size={15}/>:null}提问 · 1次</button></div></form>
+ <div><h4><GraduationCap size={19}/>用五道题巩固理解</h4><p>基础：概念识记<br/>进阶：理解与应用<br/>挑战：本节知识的综合推理</p><label>题目难度<select value={difficulty} onChange={e=>setDifficulty(e.target.value)} disabled={busy}><option>基础</option><option>进阶</option><option>挑战</option></select></label><button className="primary-button" disabled={busy||!wallet||wallet.balance<1||wallet.pending>0} onClick={()=>submit('quiz')}>生成5道题 · 1次</button></div></div>
+ <p className="practice-footnote">默认10次¥0.90，可购买10、20…100次；微信付款由商家人工核对后入账。仅发送本节课程节选和本次问题，不发送其他笔记，不读取原书；课程过长时使用前部节选。AI内容请结合课程核对。</p>
+ {wallet&&<div className="practice-history"><h4>本节记录 <small>再次查看不扣次数</small></h4>{!calls.length&&<p>还没有本节提问或练习记录。</p>}{calls.map(c=><details key={c.id} open={c===calls[0]} className="practice-record"><summary>{c.kind==='quiz'?'五道课后练习':c.question}<small>{c.status==='done'?'已扣1次':c.status==='pending'?'处理中':'未扣次数'}</small></summary><div>{c.result?.kind==='question'?<LessonText text={c.result.answer}/>:c.result?.kind==='quiz'?<><span className="practice-eyebrow">{c.result.difficulty} · 5道题</span>{c.result.questions.map((q,i)=><div className="practice-quiz" key={i}><strong>{i+1}. {q.question}</strong><details><summary>查看答案与解析（免费）</summary><LessonText text={'答案：'+q.answer+'\n解析：'+q.explanation}/></details></div>)}</>:<p>{c.error||'仍在处理，请稍后刷新记录。'}</p>}</div></details>)}{more&&(wallet.history.length>=50||older.length>0)&&<button type="button" className="quiet-button" disabled={busy} onClick={loadOlder}>查找更早的本节记录</button>}</div>}
+ </section>;
+}
