+import {apiUrl} from './runtime-urls';
+import type {Lesson} from './curriculum';
+import type {PracticeResult} from './learning-credits';
+export const LEARNING_BACKEND='https://zhixue-learning-api.zhixue-lizicheng.workers.dev';
+export const PASS_STORAGE='zhixue-learning-pass-v1';
+export type LearningPass={id:string;token:string;session:string};
+export type PracticeCall={id:string;cursor:number;kind:string;book:string;topic:string;question:string;status:string;createdAt:number;result:PracticeResult|null;error:string;charged:number};
+export type WalletView={id:string;balance:number;pending:number;history:PracticeCall[]};
+export function parsePass(text:string):LearningPass|null{const m=text.trim().match(/^(LW[A-F0-9]{48}):([a-f0-9]{48})$/);return m?{id:m[1],token:m[2],session:''}:null;}
+export function storedPass():LearningPass|null{try{const p=JSON.parse(localStorage.getItem(PASS_STORAGE)||'null');return p&&parsePass(p.id+':'+p.token)?{...p,session:typeof p.session==='string'?p.session:''}:null;}catch{return null;}}
+export function storePass(p:LearningPass){localStorage.setItem(PASS_STORAGE,JSON.stringify(p));}
+export async function learningApi<T=WalletView>(path:string,pass:LearningPass,body?:unknown):Promise<T>{const r=await fetch(apiUrl('/api/commerce/learning/wallets/'+pass.id+path,LEARNING_BACKEND),{method:body===undefined?'GET':'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+pass.token,'X-Learning-Session':pass.session},...(body===undefined?{}:{body:JSON.stringify(body)})});let b:unknown;try{b=await r.json();}catch{throw new Error('服务未返回结果。请刷新记录确认状态，避免重复提交。');}if(!r.ok)throw new Error((b as {error?:string}).error||'请求未完成。');return b as T;}
+export function courseExcerpt(l:Lesson){const text=[l.goal,l.opening,...l.terms.map(t=>t.name+'：'+t.meaning),...l.steps.map(s=>s.title+'：'+s.body),'例题：'+l.example.question,l.example.reasoning,l.example.answer,...l.checks.map(c=>c.question+'：'+c.answer)].join('\n');let out='',bytes=0;for(const c of text){const n=new TextEncoder().encode(c).length;if(bytes+n>12000)break;out+=c;bytes+=n;}return out;}
