+import type {ModelSettings} from './learning-utils';
+import {apiUrl} from './runtime-urls';
+
+export const DEEPSEEK_DEFAULT_MODEL='deepseek-flash';
+const providers=new Set(['deepseek','qwen','openai']);
+
+/** Keep credentials in the calling page's state; this module never persists them. */
+export function defaultSettings():ModelSettings{
+ return {provider:'deepseek',model:DEEPSEEK_DEFAULT_MODEL,apiKey:'',youtubeKey:'',visionProvider:'deepseek',visionModel:DEEPSEEK_DEFAULT_MODEL,visionKey:''};
+}
+
+export function getVisionSettings(settings:ModelSettings):{provider:string;model:string;apiKey:string}{
+ const selected=settings.visionProvider?.trim();
+ // Earlier versions selected Qwen before the user supplied any vision configuration.
+ const emptyLegacyChoice=settings.provider==='deepseek'&&(selected==='qwen'||selected==='openai')&&!settings.visionModel?.trim()&&!settings.visionKey?.trim();
+ const provider=!selected||emptyLegacyChoice?'deepseek':selected;
+ const model=settings.visionModel?.trim()||(provider==='deepseek'?DEEPSEEK_DEFAULT_MODEL:'');
+ const apiKey=settings.visionKey?.trim()||(provider===settings.provider?settings.apiKey.trim():'');
+ return {provider,model,apiKey};
+}
+
+/** All missing prerequisites are shown together instead of failing one click at a time. */
+export function modelConfigurationIssues(settings:ModelSettings,kind:'vision'|'text'):string[]{
+ const issues:string[]=[];
+ try{apiUrl('/api/model',settings.backendUrl);}catch(error){issues.push(error instanceof Error?error.message:'请填写有效的后端服务地址。');}
+ const configuration=kind==='vision'?getVisionSettings(settings):settings;
+ const label=kind==='vision'?'图片识别':'文字讲解';
+ if(!providers.has(configuration.provider))issues.push(`请选择${label}模型服务商。`);
+ if(!configuration.model.trim())issues.push(`请填写${label}模型名称。`);
+ if(!configuration.apiKey.trim())issues.push(configuration.provider==='deepseek'?'请填写 DeepSeek API 密钥，识别与讲解可共用同一密钥。':`请填写${label} API 密钥。`);
+ return issues;
+}
