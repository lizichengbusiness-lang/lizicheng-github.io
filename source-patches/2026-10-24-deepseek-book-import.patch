+   <label>独立图片 API 密钥（同服务商可留空共用）<input type="password" autoComplete="off" spellCheck={false} value={settings.visionKey||''} placeholder={vision.provider===settings.provider?'留空使用上方密钥':'填写图片服务商的密钥'} onChange={e=>onChange(v=>({...v,visionKey:e.target.value}))}/></label>
+  </details>
+  <details className="model-advanced"><summary>YouTube 搜索设置（可选）</summary><label>YouTube Data API 密钥<input type="password" autoComplete="off" value={settings.youtubeKey} placeholder="用于联网检索播放列表" onChange={e=>onChange(v=>({...v,youtubeKey:e.target.value}))}/></label></details>
+  <p className="form-note model-session-note"><Info size={15}/>密钥只在当前页面会话使用，刷新后需重新填写，不会进入学习库备份。模型调用可能消耗你自己账号的 API 额度。</p>
+  <button className="primary-button full" onClick={onApply}>{returnToImport?'应用设置并返回上架窗口':'应用设置'}</button>
+ </div>;
+}
