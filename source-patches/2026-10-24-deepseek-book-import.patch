new file mode 100644
index 0000000..588c71d
--- /dev/null
+++ b/lib/book-import-images.ts
@@ -0,0 +1,88 @@
+export type BookImageFile = Pick<File, 'name' | 'type' | 'size'>;
+
+/** Some mobile photo pickers omit MIME type, so allow a known extension as a fallback. */
+export function validateBookImage(file: BookImageFile): void {
+  if (/heic|heif/i.test(file.type) || /\.(heic|heif)$/i.test(file.name)) {
+    throw new Error('这张照片是 HEIC/HEIF 格式，当前无法读取。请在手机相册中转为 JPG，或将封面、目录截图后重新选择。');
+  }
+  const mime = file.type.toLowerCase();
+  const supported = /^image\/(?:jpeg|jpg|pjpeg|png|webp)$/.test(mime)
+    || (!mime && /\.(?:jpe?g|png|webp)$/i.test(file.name));
+  if (!supported) throw new Error('暂时无法读取这种图片格式。请选择 JPG、PNG 或 WebP；手机照片也可以截图后再选。');
+  if (!file.size) throw new Error('图片文件是空的，请重新选择或拍摄照片。');
+  if (file.size > 15 * 1024 * 1024) throw new Error('这张原图超过 15MB，请压缩或截图后再选择；已选好的其他图片会保留。');
+}
+
+export type DecodedBookImage = {
+  source: CanvasImageSource;
+  width: number;
+  height: number;
+  dispose: () => void;
+};
+
+export type BookImageDecoder = {
+  createBitmap?: (file: File) => Promise<ImageBitmap>;
+  createImage: () => HTMLImageElement;
+  createObjectURL: (file: File) => string;
+  revokeObjectURL: (url: string) => void;
+};
+
+function browserDecoder(): BookImageDecoder {
+  return {
+    createBitmap: typeof createImageBitmap === 'function' ? file => createImageBitmap(file) : undefined,
+    createImage: () => new Image(),
+    createObjectURL: file => URL.createObjectURL(file),
+    revokeObjectURL: url => URL.revokeObjectURL(url),
+  };
+}
+
+/** ImageBitmap is unreliable on some mobile browsers; the native image decoder is the fallback. */
+export async function decodeBookImage(file: File, decoder: BookImageDecoder = browserDecoder()): Promise<DecodedBookImage> {
+  if (decoder.createBitmap) {
+    try {
+      const bitmap = await decoder.createBitmap(file);
+      if (bitmap.width && bitmap.height) return {source: bitmap, width: bitmap.width, height: bitmap.height, dispose: () => bitmap.close()};
+      bitmap.close();
+    } catch { /* Continue with the mobile browser's normal image decoder. */ }
+  }
+  const image = decoder.createImage();
+  const url = decoder.createObjectURL(file);
+  try {
+    await new Promise<void>((resolve, reject) => {
+      const timeout = setTimeout(() => finish(new Error('图片读取超时，请重新选择照片，或截图后再试。')), 20000);
+      const finish = (error?: Error) => {
+        clearTimeout(timeout);
+        image.onload = null;
+        image.onerror = null;
+        if (error) reject(error); else resolve();
+      };
+      image.onload = () => image.naturalWidth && image.naturalHeight ? finish() : finish(new Error('照片没有可读取的尺寸，请重新选择。'));
+      image.onerror = () => finish(new Error('浏览器未能读出这张照片。请换用 JPG/PNG，或将封面、目录截图后重新选择。'));
+      image.src = url;
+    });
+    return {source: image, width: image.naturalWidth, height: image.naturalHeight, dispose: () => decoder.revokeObjectURL(url)};
+  } catch (error) {
+    decoder.revokeObjectURL(url);
+    throw error;
+  }
+}
+
+export async function prepareBookPhoto(file: File): Promise<string> {
+  validateBookImage(file);
+  const decoded = await decodeBookImage(file);
+  try {
+    const scale = Math.min(1, 1800 / Math.max(decoded.width, decoded.height));
+    const canvas = document.createElement('canvas');
+    canvas.width = Math.max(1, Math.round(decoded.width * scale));
+    canvas.height = Math.max(1, Math.round(decoded.height * scale));
+    const context = canvas.getContext('2d');
+    if (!context) throw new Error('当前浏览器无法处理图片，请换用手机系统浏览器，或直接粘贴目录文字。');
+    context.drawImage(decoded.source, 0, 0, canvas.width, canvas.height);
+    const data = canvas.toDataURL('image/jpeg', .84);
+    if (!data.startsWith('data:image/jpeg;')) throw new Error('图片转换失败，请截图后重新选择。');
+    if (data.length > 1500000) throw new Error('压缩后的图片仍然太大，请裁剪到封面或目录区域后重试。');
+    return data;
+  } finally {
+    decoded.dispose();
+  }
+}
diff --git a/lib/library-persistence.ts b/lib/library-persistence.ts
new file mode 100644
index 0000000..da02ed9
--- /dev/null
+++ b/lib/library-persistence.ts
@@ -0,0 +1,55 @@
+import { LIBRARY_STORAGE_KEY, serializeLibrary, type LearningLibrary } from './library-store';
+
+export type LibraryCommitReceipt = {
+  spaceId: string;
+  persisted: boolean;
+  changed: boolean;
+  error: string;
+};
+
+export type LibraryWrite = (key: string, value: string) => void;
+export type LibraryReference = { current: LearningLibrary };
+
+export function persistLibrary(
+  library: LearningLibrary,
+  write: LibraryWrite,
+): Pick<LibraryCommitReceipt, 'persisted' | 'error'> {
+  let content: string;
+  try {
+    content = serializeLibrary(library);
+  } catch {
+    return {
+      persisted: false,
+      error: '学习数据暂时无法整理保存。本次内容仍在页面中，请保留当前页面并重试，暂不要刷新或关闭。',
+    };
+  }
+  try {
+    write(LIBRARY_STORAGE_KEY, content);
+    return { persisted: true, error: '' };
+  } catch (cause) {
+    const name = cause && typeof cause === 'object' && 'name' in cause ? String(cause.name) : '';
+    const reason = name === 'QuotaExceededError' || name === 'NS_ERROR_DOM_QUOTA_REACHED'
+      ? '浏览器存储空间不足'
+      : name === 'SecurityError' ? '浏览器禁止了本地存储，可能受隐私模式或权限设置限制' : '浏览器本地存储暂时不可用';
+    return {
+      persisted: false,
+      error: `${reason}。本次内容仍在当前页面，请导出完整学习库备份；刷新或关闭页面后可能丢失。`,
+    };
+  }
+}
+
+/** Mutations advance this reference immediately, before React schedules a render. */
+export function commitLibraryChange(
+  reference: LibraryReference,
+  mutation: (current: LearningLibrary) => LearningLibrary,
+  write: LibraryWrite,
+  spaceId?: string,
+): LibraryCommitReceipt {
+  const previous = reference.current;
+  const next = mutation(previous);
+  const targetId = spaceId ?? next.activeId;
+  if (next === previous) return { spaceId: targetId, persisted: false, changed: false, error: '' };
+  // A failed disk write must not discard the learner's latest in-memory work.
+  reference.current = next;
+  return { spaceId: targetId, changed: true, ...persistLibrary(next, write) };
+}
