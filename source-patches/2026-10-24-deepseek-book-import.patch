+export function bookSelectionMessage(coverCount: number, directoryCount: number): string {
+  const parts = [coverCount ? '1 张封面' : '', directoryCount ? `${directoryCount} 张目录` : ''].filter(Boolean);
+  return parts.length ? `已选好 ${parts.join('、')}，尚未上架。请继续识别或填写目录，再确认上架。` : '还没有选择图片。也可以直接填写书名、粘贴目录来上架。';
+}
+
+export function bookSubmissionIssues(title: string, toc: string, unitCount: number): string[] {
+  const issues: string[] = [];
+  if (!title.trim()) issues.push('还缺书名，请填写书名，或先识别封面。');
+  if (!toc.trim()) issues.push('还缺目录文字。选好目录图片后需要点击“识别封面和目录”，也可以直接粘贴目录。');
+  else if (!unitCount) issues.push('没有解析到有效章节，请按每行一个章节或小节填写目录。');
+  return issues;
+}
+
+export function bookRequestError(error: unknown): string {
+  if (error instanceof TypeError) return '未能连接识别服务。请检查网络和后端服务地址；已选图片与填写内容仍保留，可重新识别。';
+  if (error instanceof SyntaxError) return '识别服务返回了无法解析的内容。请检查后端服务地址，或稍后重试；也可手动填写目录。';
+  if (error instanceof Error && (error.name === 'TimeoutError' || error.name === 'AbortError')) return '识别超时，请稍后重试或减少目录图片数量；已选内容仍保留。';
+  return error instanceof Error && error.message ? error.message : '识别没有完成，请重试，或直接填写目录；已选内容仍保留。';
+}
