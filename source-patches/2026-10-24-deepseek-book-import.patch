--- /dev/null
+++ b/tests/book-import.test.mjs
@@ -0,0 +1,71 @@
+import assert from 'node:assert/strict';
+import {validateBookImage,decodeBookImage} from '../lib/book-import-images.ts';
+import {bookRequestError,bookSelectionMessage,bookSubmissionIssues} from '../lib/book-import-feedback.ts';
+
+const jpeg=new File(['photo'],'手机封面.JPG',{type:'image/jpeg'});
+assert.doesNotThrow(()=>validateBookImage(jpeg));
+assert.doesNotThrow(()=>validateBookImage({name:'手机目录.PNG',type:'',size:64}),'Mobile pickers with a known extension and no MIME type are supported');
+assert.doesNotThrow(()=>validateBookImage({name:'camera',type:'image/pjpeg',size:64}));
+assert.throws(()=>validateBookImage({name:'IMG_1.HEIC',type:'image/heic',size:64}),/HEIC\/HEIF.*JPG.*截图/);
+assert.throws(()=>validateBookImage({name:'目录.svg',type:'image/svg+xml',size:64}),/JPG、PNG 或 WebP/);
+assert.throws(()=>validateBookImage({name:'封面.jpg',type:'image/jpeg',size:0}),/文件是空的/);
+assert.throws(()=>validateBookImage({name:'封面.jpg',type:'image/jpeg',size:16*1024*1024}),/超过 15MB/);
+assert.throws(()=>validateBookImage({name:'假.jpg',type:'text/html',size:64}),/图片格式/,'A known non-image MIME cannot be disguised by a JPG extension');
+
+let bitmapClosed=0,imageCalls=0;
+const bitmap={width:1200,height:1800,close(){bitmapClosed++;}};
+const bitmapResult=await decodeBookImage(jpeg,{
+  createBitmap:async()=>bitmap,
+  createImage(){imageCalls++;throw new Error('Should use the decoded bitmap');},
+  createObjectURL(){throw new Error('Should not need an object URL');},
+  revokeObjectURL(){throw new Error('Should not revoke an unused URL');},
+});
+assert.equal(bitmapResult.width,1200);
+assert.equal(bitmapResult.source,bitmap);
+assert.equal(imageCalls,0);
+bitmapResult.dispose();
+assert.equal(bitmapClosed,1);
+
+function fallbackDecoder({failBitmap=false,failImage=false,emptyBitmap=false}={}){
+  const revoked=[];
+  let closed=0,created=0;
+  return {
+    revoked,get closed(){return closed;},get created(){return created;},
+    runtime:{
+      createBitmap:failBitmap?async()=>{throw new Error('Unsupported browser image codec');}:emptyBitmap?async()=>({width:0,height:0,close(){closed++;}}):undefined,
+      createImage(){
+        created++;
+        return {naturalWidth:960,naturalHeight:1440,onload:null,onerror:null,set src(value){assert.equal(value,'blob:mobile-photo');queueMicrotask(()=>failImage?this.onerror?.():this.onload?.());}};
+      },
+      createObjectURL(file){assert.equal(file,jpeg);return'blob:mobile-photo';},
+      revokeObjectURL(url){revoked.push(url);},
+    },
+  };
+}
+for(const options of [{},{failBitmap:true},{emptyBitmap:true}]){
+  const mobile=fallbackDecoder(options);
+  const decoded=await decodeBookImage(jpeg,mobile.runtime);
+  assert.equal(decoded.width,960);
+  assert.equal(decoded.height,1440);
+  assert.equal(mobile.created,1,'Missing, failed, or empty ImageBitmap uses the normal browser image decoder');
+  assert.deepEqual(mobile.revoked,[],'Keep the image URL alive until canvas has drawn the image');
+  decoded.dispose();
+  assert.deepEqual(mobile.revoked,['blob:mobile-photo']);
+  if(options.emptyBitmap)assert.equal(mobile.closed,1,'Dispose an unusable bitmap before falling back');
+}
+const broken=fallbackDecoder({failBitmap:true,failImage:true});
+await assert.rejects(decodeBookImage(jpeg,broken.runtime),/浏览器未能读出.*截图/);
+assert.deepEqual(broken.revoked,['blob:mobile-photo'],'Failed mobile decode releases its object URL');
+
+assert.match(bookSelectionMessage(1,2),/1 张封面、2 张目录.*尚未上架/);
+assert.match(bookSelectionMessage(0,0),/直接填写书名/);
+assert.deepEqual(bookSubmissionIssues('高等数学','第一章 极限',1),[],'Manual contents can be shelved without model configuration');
+assert.equal(bookSubmissionIssues('','',0).length,2,'Explain both missing title and missing contents');
+assert.match(bookSubmissionIssues('目录识别测试','',0).join(' '),/点击“识别封面和目录”/,'Photos alone do not mean contents are recognized');
+assert.match(bookSubmissionIssues('高等数学','目录',0).join(' '),/没有解析到有效章节/);
+assert.match(bookRequestError(new TypeError('Failed to fetch')),/网络和后端服务地址/);
+assert.match(bookRequestError(new SyntaxError('Unexpected token')),/无法解析/);
+assert.match(bookRequestError(new DOMException('Timed out','AbortError')),/识别超时/);
+assert.equal(bookRequestError(new Error('DeepSeek 余额不足')),'DeepSeek 余额不足');
+
+console.log(JSON.stringify({mobilePhotoDecoding:'bitmap + missing/rejected/empty fallback checked',resources:'disposed on success and failure',formats:'MIME-less mobile photo and HEIC guidance checked',shelving:'specific missing fields and model-free manual flow checked'}));
diff --git a/tests/library-persistence.test.mjs b/tests/library-persistence.test.mjs
new file mode 100644
index 0000000..7635177
--- /dev/null
+++ b/tests/library-persistence.test.mjs
@@ -0,0 +1,78 @@
+import assert from 'node:assert/strict';
+import { commitLibraryChange, persistLibrary } from '../lib/library-persistence.ts';
+import {
+  createDefaultLibrary, createSpace, LIBRARY_STORAGE_KEY, mergeLibraries,
+  parseLibrary, serializeLibrary, updateLibrarySpace,
+} from '../lib/library-store.ts';
+
+const initial = createDefaultLibrary();
+const disk = new Map([[LIBRARY_STORAGE_KEY, serializeLibrary(initial)]]);
+let writes = 0;
+const write = (key, content) => { writes++; disk.set(key, content); };
+const reference = { current: initial };
+
+// A real saved receipt must correspond to the complete data that can be read back.
+const saved = commitLibraryChange(reference, current => updateLibrarySpace(current, current.activeId, { title: '已保存的书' }), write);
+assert.equal(saved.changed, true);
+assert.equal(saved.persisted, true);
+assert.equal(saved.error, '');
+assert.equal(saved.spaceId, initial.activeId);
+assert.equal(parseLibrary(disk.get(LIBRARY_STORAGE_KEY)).spaces[0].title, '已保存的书');
+
+// Quota failures retain both the old on-disk value and the newest in-memory work.
+const beforeQuota = disk.get(LIBRARY_STORAGE_KEY);
+const quotaWrite = () => { throw new DOMException('quota detail should not leak', 'QuotaExceededError'); };
+const quota = commitLibraryChange(reference, current => updateLibrarySpace(current, current.activeId, space => ({ notes: { ...space.notes, amino: '需要备份的新笔记' } })), quotaWrite);
+assert.equal(quota.changed, true);
+assert.equal(quota.persisted, false);
+assert.match(quota.error, /存储空间不足/);
+assert.doesNotMatch(quota.error, /quota detail/);
+assert.equal(disk.get(LIBRARY_STORAGE_KEY), beforeQuota);
+assert.equal(reference.current.spaces[0].notes.amino, '需要备份的新笔记');
+const backup = parseLibrary(serializeLibrary(reference.current));
+assert.equal(backup.spaces[0].notes.amino, '需要备份的新笔记', 'Disk failure must not prevent exporting a valid in-memory library');
+
+// Denied access is distinguished from a full disk, and messages never expose raw exceptions.
+const denied = persistLibrary(reference.current, () => { throw new DOMException('private technical data', 'SecurityError'); });
+assert.equal(denied.persisted, false);
+assert.match(denied.error, /禁止了本地存储/);
+assert.doesNotMatch(denied.error, /private technical data/);
+const unavailable = persistLibrary(reference.current, () => { throw new Error('sensitive details'); });
+assert.match(unavailable.error, /本地存储暂时不可用/);
+assert.doesNotMatch(unavailable.error, /sensitive details/);
+
+// Invalid/future data cannot be serialized into a successful disk write.
+const futureLibrary = { ...reference.current, schemaVersion: 99 };
+const beforeBadData = disk.get(LIBRARY_STORAGE_KEY), writesBeforeBadData = writes;
+const serialization = commitLibraryChange(reference, () => futureLibrary, write);
+assert.equal(serialization.changed, true);
+assert.equal(serialization.persisted, false);
+assert.match(serialization.error, /无法整理保存/);
+assert.equal(reference.current, futureLibrary, 'Keep the attempted data available for recovery instead of silently replacing it');
+assert.equal(writes, writesBeforeBadData, 'Serialization must finish before touching browser storage');
+assert.equal(disk.get(LIBRARY_STORAGE_KEY), beforeBadData);
+
+// A late result for a missing project is not a successful update and performs no write.
+reference.current = backup;
+const beforeMissing = reference.current, writesBeforeMissing = writes;
+const missing = commitLibraryChange(reference, current => updateLibrarySpace(current, 'missing-project', { title: '不能写入' }), write, 'missing-project');
+assert.deepEqual(missing, { spaceId: 'missing-project', changed: false, persisted: false, error: '' });
+assert.equal(reference.current, beforeMissing);
+assert.equal(writes, writesBeforeMissing);
+
+// Sequential mutations made before React renders must build on one another.
+const book = createSpace({ id: initial.activeId, title: '新数学教材', field: 'math' });
+const added = commitLibraryChange(reference, current => {
+  const merged = mergeLibraries(current, { schemaVersion: 3, activeId: book.id, spaces: [book] });
+  return { ...merged, activeId: merged.spaces.at(-1).id };
+}, write);
+assert.equal(added.persisted, true);
+assert.notEqual(added.spaceId, initial.activeId, 'An ID collision must report the actual added project');
+const changed = commitLibraryChange(reference, current => updateLibrarySpace(current, added.spaceId, space => ({ title: `${space.title}（连续更新）` })), write, added.spaceId);
+assert.equal(changed.persisted, true);
+assert.equal(reference.current.spaces.length, backup.spaces.length + 1);
+assert.equal(reference.current.spaces.at(-1).title, '新数学教材（连续更新）');
+assert.equal(parseLibrary(disk.get(LIBRARY_STORAGE_KEY)).spaces.at(-1).title, '新数学教材（连续更新）');
+assert.equal(parseLibrary(disk.get(LIBRARY_STORAGE_KEY)).spaces[0].notes.amino, '需要备份的新笔记', 'A later successful write must include work retained after an earlier quota failure');
+
+console.log('Library persistence receipts verified: durable success, quota/permission/serialization failure, backup recovery, missing targets, and consecutive updates.');
diff --git a/tests/model-settings.test.mjs b/tests/model-settings.test.mjs
new file mode 100644
index 0000000..f068eca
--- /dev/null
+++ b/tests/model-settings.test.mjs
@@ -0,0 +1,85 @@
+import assert from 'node:assert/strict';
+import {defaultSettings,getVisionSettings,modelConfigurationIssues,DEEPSEEK_DEFAULT_MODEL} from '../lib/model-settings.ts';
+import {POST} from '../app/api/model/route.ts';
+
+const defaults=defaultSettings();
+assert.equal(defaults.provider,'deepseek');
+assert.equal(defaults.model,DEEPSEEK_DEFAULT_MODEL);
+assert.equal(defaults.visionKey,'');
+const configured={...defaults,apiKey:'mock-shared-key',backendUrl:'https://api.example'};
+assert.deepEqual(getVisionSettings(configured),{provider:'deepseek',model:'deepseek-flash',apiKey:configured.apiKey});
+assert.deepEqual(getVisionSettings({...configured,model:'deepseek-v4-pro'}),getVisionSettings(configured),'A text-only primary model must not silently become the vision model');
+assert.equal(getVisionSettings({...configured,visionKey:'  mock-vision-override  '}).apiKey,'mock-vision-override');
+assert.deepEqual(getVisionSettings({...configured,visionProvider:'qwen',visionModel:'',visionKey:''}),getVisionSettings(configured),'The previous unconfigured Qwen default should not require a second provider');
+assert.deepEqual(getVisionSettings({...configured,visionProvider:'qwen',visionModel:'qwen-vl-test',visionKey:'mock-qwen-key'}),{provider:'qwen',model:'qwen-vl-test',apiKey:'mock-qwen-key'});
+assert.equal(getVisionSettings({...defaults,provider:'openai',apiKey:'mock-openai-key'}).apiKey,'','Never send another provider\'s key to DeepSeek');
+
+const descriptor=Object.getOwnPropertyDescriptor(globalThis,'__STUDY_STATIC__');
+try{
+ globalThis.__STUDY_STATIC__=true;
+ const missing=modelConfigurationIssues(defaults,'vision');
+ assert.ok(missing.some(issue=>/后端服务地址/.test(issue)));
+ assert.ok(missing.some(issue=>/DeepSeek API 密钥/.test(issue)));
+ assert.equal(missing.length,2,'Show missing backend and key together');
+ assert.deepEqual(modelConfigurationIssues(configured,'vision'),[]);
+ assert.deepEqual(modelConfigurationIssues(configured,'text'),[]);
+ assert.ok(modelConfigurationIssues({...configured,backendUrl:'http://unsafe.example'},'vision').some(issue=>/HTTPS/.test(issue)));
+ assert.ok(modelConfigurationIssues({...configured,visionProvider:'qwen',visionModel:'qwen-vl-test',visionKey:''},'vision').some(issue=>/图片识别 API 密钥/.test(issue)));
+ globalThis.__STUDY_STATIC__=false;
+ assert.deepEqual(modelConfigurationIssues({...configured,backendUrl:''},'text'),[],'The original same-origin host does not require a second backend');
+}finally{
+ if(descriptor)Object.defineProperty(globalThis,'__STUDY_STATIC__',descriptor);else delete globalThis.__STUDY_STATIC__;
+}
+
+const originalFetch=globalThis.fetch,calls=[];
+let upstreamStatus=200,upstreamBody=null,networkFailure=null;
+const image='data:image/png;base64,aGVsbG8=';
+const request=body=>new Request('https://api.example/api/model',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
+const recognition={...getVisionSettings(configured),task:'bookvision',text:'识别封面与目录',images:[image]};
+globalThis.fetch=async(url,options)=>{
+ calls.push({url:String(url),options,payload:JSON.parse(options.body)});
+ if(networkFailure)throw networkFailure;
+ if(upstreamBody!==null)return new Response(upstreamBody,{status:upstreamStatus});
+ return Response.json({choices:[{finish_reason:'stop',message:{content:JSON.stringify({title:'新书',toc:'第一章 基础'})}}]},{status:upstreamStatus});
+};
+try{
+ let response=await POST(request(recognition));
+ assert.equal(response.status,200);
+ assert.equal(calls.at(-1).url,'https://api.deepseek.com/chat/completions');
+ assert.equal(calls.at(-1).options.headers.Authorization,`Bearer ${configured.apiKey}`);
+ assert.equal(calls.at(-1).payload.model,'deepseek-flash');
+ assert.deepEqual(calls.at(-1).payload.thinking,{type:'disabled'});
+ assert.deepEqual(calls.at(-1).payload.messages[1].content[1],{type:'image_url',image_url:{url:image}});
+ assert.equal(calls.at(-1).payload.messages[1].role,'user');
+ assert.equal(response.headers.get('Cache-Control'),'no-store');
+
+ const before=calls.length;
+ response=await POST(request({...recognition,model:'deepseek-v4-pro'}));
+ assert.equal(response.status,400);assert.match((await response.json()).error,/deepseek-flash/);
+ assert.equal(calls.length,before,'Reject unsupported vision models before sending images');
+
+ response=await POST(request({...recognition,provider:'qwen',model:'qwen-vl-test',apiKey:'mock-qwen-key'}));
+ assert.equal(response.status,200);assert.match(calls.at(-1).url,/dashscope\.aliyuncs\.com/);
+ assert.equal(calls.at(-1).payload.thinking,undefined,'DeepSeek options must not be sent to other providers');
+
+ response=await POST(request({...recognition,task:'explain',text:'解释基础概念'}));
+ assert.equal(response.status,200);assert.equal(calls.at(-1).payload.thinking,undefined);
+ assert.equal(typeof calls.at(-1).payload.messages[1].content,'string');
+ for(const [status,expectedResponse,pattern] of [[401,401,/密钥无效/],[403,401,/访问权限/],[402,402,/余额|额度不足/],[429,429,/过于频繁|上限/],[404,400,/deepseek-flash/],[422,400,/deepseek-flash/],[408,504,/超时/],[504,504,/超时/],[503,502,/暂时不可用/]]){
+  upstreamStatus=status;upstreamBody=`sensitive upstream content ${configured.apiKey}`;
+  response=await POST(request(recognition));
+  assert.equal(response.status,expectedResponse);
+  const output=await response.text();assert.match(output,pattern);assert.ok(!output.includes(configured.apiKey));assert.ok(!output.includes('sensitive upstream content'));
+  assert.equal(response.headers.get('Cache-Control'),'no-store');
+ }
+ upstreamStatus=200;upstreamBody='<html>not a model response</html>';
+ response=await POST(request(recognition));assert.equal(response.status,502);assert.match((await response.json()).error,/无法解析/);
+ upstreamBody=JSON.stringify({choices:[{message:{content:17}}]});
+ response=await POST(request(recognition));assert.equal(response.status,502);assert.match((await response.json()).error,/未返回可用内容/);
+ upstreamBody=null;networkFailure=new DOMException('mock timeout details','TimeoutError');
+ response=await POST(request(recognition));assert.equal(response.status,504);assert.match((await response.json()).error,/超时/);
+ networkFailure=new TypeError(`network error containing ${configured.apiKey}`);
+ response=await POST(request(recognition));assert.equal(response.status,502);assert.ok(!(await response.text()).includes(configured.apiKey));
+}finally{globalThis.fetch=originalFetch;}
+
+console.log(JSON.stringify({deepseek:'one key for vision and text',modelSelection:'Flash remains the vision default for Pro text users',legacyProviders:'preserved',configuration:'all missing prerequisites shown',visionPayload:'mock verified',apiErrors:'safe and specific',liveModel:'not called — mocked only'}));
