@@ -0,0 +1,90 @@
+/** Server-side pricing policy for the proposed manually approved book service.
+ * Money is represented in millionths of CNY to avoid rounding at the ¥9 boundary.
+ * An estimate is not an actual cost cap. Checkout must persist the quote and
+ * generation must enforce a separate, atomic reservation ledger.
+ */
+export const BOOK_PRICING = Object.freeze({
+  version: '2026-10-26-v1',
+  model: 'deepseek-flash',
+  salePriceFen: 990,
+  rejectAtMicroCny: 9_000_000,
+  inputMicroCnyPerToken: 2,
+  outputMicroCnyPerToken: 8,
+  retryReservePercent: 20,
+});
+
+export type BookTokenEstimate = {
+  inputTokens: number;
+  outputTokens: number;
+  extraCostMicroCny?: number;
+};
+
+export type BookPriceQuote = {
+  policyVersion: string;
+  model: string;
+  supported: boolean;
+  estimatedCostMicroCny: number;
+  estimatedCostCny: string;
+  salePriceFen: number | null;
+  customerMessage: string;
+};
+
+function nonnegativeInteger(value: unknown, label: string): asserts value is number {
+  if (!Number.isSafeInteger(value) || (value as number) < 0) {
+    throw new Error(`${label}必须是非负安全整数`);
+  }
+}
+
+export function quoteBook(estimate: BookTokenEstimate): BookPriceQuote {
+  nonnegativeInteger(estimate.inputTokens, '输入 token 估计');
+  nonnegativeInteger(estimate.outputTokens, '输出 token 估计');
+  const extra = estimate.extraCostMicroCny ?? 0;
+  nonnegativeInteger(extra, '其他预估成本');
+  if (estimate.inputTokens === 0 || estimate.outputTokens === 0) {
+    throw new Error('完整估价需要有效的输入和输出 token 估计');
+  }
+  const raw = estimate.inputTokens * BOOK_PRICING.inputMicroCnyPerToken
+    + estimate.outputTokens * BOOK_PRICING.outputMicroCnyPerToken;
+  return quoteEstimatedCost(raw, extra);
+}
+
+export function quoteEstimatedCost(raw: number, extra = 0): BookPriceQuote {
+  nonnegativeInteger(raw, '预估模型成本');
+  nonnegativeInteger(extra, '其他预估成本');
+  // Do not round to two decimal places before testing eligibility.
+  const numerator = raw * (100 + BOOK_PRICING.retryReservePercent);
+  if (!Number.isSafeInteger(numerator)) throw new Error('估价数据超出支持范围');
+  const total = Math.ceil(numerator / 100) + extra;
+  if (!Number.isSafeInteger(total)) throw new Error('估价数据超出支持范围');
+  const supported = total < BOOK_PRICING.rejectAtMicroCny;
+  return {
+    policyVersion: BOOK_PRICING.version,
+    model: BOOK_PRICING.model,
+    supported,
+    estimatedCostMicroCny: total,
+    // Round the displayed estimate upward, independently of the decision.
+    estimatedCostCny: (Math.ceil(total / 10_000) / 100).toFixed(2),
+    salePriceFen: supported ? BOOK_PRICING.salePriceFen : null,
+    customerMessage: supported
+      ? '本书支持整本生成，价格 ¥9.90，付款前请核对目录和生成范围。'
+      : '本书暂不支持整本生成，不会创建付款订单。',
+  };
+}
+
+/** A planning helper, not a tokenizer or a guarantee about model charges. */
+export function estimateBookBySections(
+  sections: number,
+  inputTokensPerSection: number,
+  outputTokensPerSection: number,
+  extraCostMicroCny = 0,
+): BookPriceQuote {
+  nonnegativeInteger(sections, '小节数');
+  nonnegativeInteger(inputTokensPerSection, '每节输入 token 估计');
+  nonnegativeInteger(outputTokensPerSection, '每节输出 token 估计');
+  if (!sections) throw new Error('目录至少需要一个学习单元');
+  return quoteBook({
+    inputTokens: sections * inputTokensPerSection,
+    outputTokens: sections * outputTokensPerSection,
+    extraCostMicroCny,
+  });
+}
