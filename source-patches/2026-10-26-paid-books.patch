@@ -0,0 +1,201 @@
+import {DurableObject} from 'cloudflare:workers';
+import personalWorker from './api-worker';
+import {readBook,commercialQuote,callReservation,lessonMessages,actualModelCost,parseCommercialLesson,randomSecret,sha256,constantTimeEqual,COMMERCE_POLICY,CommerceError,orderStatusLabel,type CommercialBook} from '../lib/commerce-core';
+import {inferField} from '../lib/subject-catalog';
+import {parseContents,topicsFromContents} from '../lib/curriculum';
+
+type Env={ALLOWED_ORIGINS?:string;ORDERS:DurableObjectNamespace;COMMERCE_ASSETS:Fetcher;DEEPSEEK_API_KEY?:string;COMMERCE_ADMIN_KEY?:string;COMMERCE_DAILY_BUDGET_CNY?:string;COMMERCE_PREVIEW?:string;MODEL_FETCH?:typeof fetch};
+type OrderRow={id:string;token_hash:string;book_json:string;status:string;created_at:number;updated_at:number;estimated_micro:number;spent_micro:number;payment_ref:string|null;note:string;error:string};
+type UnitRow={order_id:string;idx:number;status:string;attempts:number;content_json:string|null;reserved_micro:number;lease_until:number;reserve_day:number;claim:string;error:string};
+const reply=(value:unknown,status=200)=>Response.json(value,{status,headers:{'Cache-Control':'no-store','X-Content-Type-Options':'nosniff'}});
+const bearer=(r:Request)=>r.headers.get('Authorization')?.replace(/^Bearer\s+/i,'')||'';
+function ready(env:Env){return Boolean(env.DEEPSEEK_API_KEY?.trim()&&env.COMMERCE_ADMIN_KEY&&env.COMMERCE_ADMIN_KEY.length>=16);}
+async function jsonBody(r:Request){if(Number(r.headers.get('content-length')||0)>100000)throw new CommerceError('请求过大。',413);const t=await r.text();if(t.length>100000)throw new CommerceError('请求过大。',413);try{return JSON.parse(t);}catch{throw new CommerceError('请求格式无效。');}}
+const day=()=>Math.floor((Date.now()+8*3600000)/86400000);
+const customerError=(error:unknown)=>error instanceof CommerceError?reply({error:error.message},error.status):reply({error:'服务暂时不可用，请稍后重试。'},503);
+
+export class BookCommerce extends DurableObject<Env>{
+ constructor(ctx:DurableObjectState,env:Env){super(ctx,env);
+  ctx.storage.sql.exec(`CREATE TABLE IF NOT EXISTS orders(id TEXT PRIMARY KEY,token_hash TEXT NOT NULL,book_json TEXT NOT NULL,status TEXT NOT NULL,created_at INTEGER NOT NULL,updated_at INTEGER NOT NULL,estimated_micro INTEGER NOT NULL,spent_micro INTEGER NOT NULL DEFAULT 0,payment_ref TEXT UNIQUE,note TEXT NOT NULL DEFAULT '',error TEXT NOT NULL DEFAULT '')`);
+  ctx.storage.sql.exec(`CREATE TABLE IF NOT EXISTS units(order_id TEXT NOT NULL,idx INTEGER NOT NULL,status TEXT NOT NULL DEFAULT 'queued',attempts INTEGER NOT NULL DEFAULT 0,content_json TEXT,reserved_micro INTEGER NOT NULL DEFAULT 0,lease_until INTEGER NOT NULL DEFAULT 0,reserve_day INTEGER NOT NULL DEFAULT 0,claim TEXT NOT NULL DEFAULT '',error TEXT NOT NULL DEFAULT '',PRIMARY KEY(order_id,idx))`);
+  ctx.storage.sql.exec(`CREATE TABLE IF NOT EXISTS daily(day INTEGER PRIMARY KEY,spent_micro INTEGER NOT NULL DEFAULT 0,reserved_micro INTEGER NOT NULL DEFAULT 0)`);
+  ctx.storage.sql.exec(`CREATE TABLE IF NOT EXISTS rate_limits(key TEXT PRIMARY KEY,count INTEGER NOT NULL,until_at INTEGER NOT NULL)`);
+  ctx.storage.sql.exec(`CREATE TABLE IF NOT EXISTS settings(key TEXT PRIMARY KEY,value TEXT NOT NULL)`);
+ }
