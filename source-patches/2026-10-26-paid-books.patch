+function req(path,method='GET',body,token=''){return new Request('https://internal'+path,{method,headers:{'Content-Type':'application/json','X-Client-Key':Math.random().toString(36),...(token?{Authorization:'Bearer '+token}:{})},...(body!==undefined?{body:JSON.stringify(body)}:{})});}
+async function result(h,path,method='GET',body,token=''){const r=await h.store.fetch(req(path,method,body,token));return {status:r.status,data:await r.json()};}
+const book={title:'Python入门',toc:'第一章 变量\n1.1 变量与赋值',level:'零基础'};
+const h=harness();
+assert.equal((await result(h,'/config')).data.acceptingOrders,true);
