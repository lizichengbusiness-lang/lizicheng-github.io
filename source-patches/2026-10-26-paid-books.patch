diff --git a/tests/book-pricing.test.mjs b/tests/book-pricing.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/book-pricing.test.mjs
@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict';
+import { BOOK_PRICING, quoteBook, estimateBookBySections } from '../lib/book-pricing.ts';
+
+// 1.2 * (1000 * 2 + 1000 * 8) = 12,000 micro-CNY.
+const base = { inputTokens: 1000, outputTokens: 1000 };
+const below = quoteBook({ ...base, extraCostMicroCny: 8_987_999 });
+assert.equal(below.estimatedCostMicroCny, 8_999_999);
+assert.equal(below.supported, true);
+assert.equal(below.salePriceFen, 990);
+assert.equal(below.estimatedCostCny, '9.00');
+
+// Exactly ¥9 is rejected under the strict "less than 9" rule.
+for (const extraCostMicroCny of [8_988_000, 8_988_001, 100_000_000]) {
+  const quote = quoteBook({ ...base, extraCostMicroCny });
+  assert.equal(quote.supported, false);
+  assert.equal(quote.salePriceFen, null);
+}
+
+for (const value of [-1, 0.1, NaN, Infinity, Number.MAX_SAFE_INTEGER, '1000']) {
+  assert.throws(() => quoteBook({ inputTokens: value, outputTokens: 1000 }));
+}
+assert.throws(() => quoteBook({ inputTokens: 0, outputTokens: 1000 }));
+assert.throws(() => quoteBook({ ...base, extraCostMicroCny: -1 }));
+assert.throws(() => estimateBookBySections(0, 8000, 3000));
+
+assert.equal(estimateBookBySections(100, 8000, 3000).estimatedCostMicroCny, 4_800_000);
+assert.equal(estimateBookBySections(200, 8000, 3000).supported, false);
+assert.equal(estimateBookBySections(100, 20000, 10000).estimatedCostMicroCny, 14_400_000);
+assert.equal(BOOK_PRICING.salePriceFen, 990);
+console.log('Passed: strict ¥9 cutoff, fixed ¥9.90 price, reserve, invalid inputs, and large-book estimates.');
