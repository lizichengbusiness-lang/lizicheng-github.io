+assert.equal((await result(h,'/admin/orders/'+order.id+'/approve','POST',approval,adminKey)).data.status,'paid');
+await h.store.alarm();assert.equal(modelCalls,1);
+await h.store.alarm();assert.equal(modelCalls,1,'Redelivered alarm cannot regenerate a completed unit');
+const done=(await result(h,'/orders/'+order.id,'GET',undefined,accessToken)).data;
+assert.equal(done.status,'complete');assert.equal(done.lessons.length,1);
+assert.ok(!JSON.stringify(done).includes(h.env.DEEPSEEK_API_KEY));
+const exported=await result(h,'/orders/'+order.id+'/download','GET',undefined,accessToken);
+assert.equal(exported.data.schemaVersion,3);assert.equal(exported.data.spaces[0].topics[0].lesson.goal,validLesson.goal);
+const second=(await result(h,'/orders','POST',book)).data;
+assert.equal((await result(h,'/admin/orders/'+second.order.id+'/approve','POST',approval,adminKey)).status,409,'One payment cannot approve two orders');
+const restart=new BookCommerce(h.ctx,h.env);
+assert.equal((await (await restart.fetch(req('/orders/'+order.id,'GET',undefined,accessToken))).json()).status,'complete','Order survives object reconstruction');
+const large={title:'大部头',toc:Array.from({length:300},(_,i)=>`${i+1} 章节标题`).join('\n')};
+assert.equal((await result(h,'/quote','POST',large)).data.supported,false);
+assert.equal((await result(h,'/orders','POST',large)).status,400);
+const off=harness({DEEPSEEK_API_KEY:''});assert.equal((await result(off,'/config')).data.acceptingOrders,false);assert.equal((await result(off,'/orders','POST',book)).status,503);
+const limited=harness({COMMERCE_DAILY_BUDGET_CNY:'0.001'});const lo=(await result(limited,'/orders','POST',book)).data;
+await result(limited,'/admin/orders/'+lo.order.id+'/approve','POST',{...approval,reference:'LIMIT123'},adminKey);
+await limited.store.alarm();assert.equal((await result(limited,'/orders/'+lo.order.id,'GET',undefined,lo.accessToken)).data.status,'paused');assert.equal(modelCalls,1,'Daily budget enforced before provider call');
+const expensive=harness();const eo=(await result(expensive,'/orders','POST',book)).data;
+await result(expensive,'/admin/orders/'+eo.order.id+'/approve','POST',{...approval,reference:'BUDGET123'},adminKey);
+expensive.db.prepare('UPDATE orders SET spent_micro=? WHERE id=?').run(COMMERCE_POLICY.budgetMicroCny-1,eo.order.id);
+await expensive.store.alarm();assert.equal(modelCalls,1,'Per-order budget enforced before provider call');
+let uncertainCalls=0;
+const uncertain=harness({MODEL_FETCH:async()=>{uncertainCalls++;throw new Error('network');}});const uo=(await result(uncertain,'/orders','POST',book)).data;
+await result(uncertain,'/admin/orders/'+uo.order.id+'/approve','POST',{...approval,reference:'UNCERTAIN123'},adminKey);
+await uncertain.store.alarm();await uncertain.store.alarm();await uncertain.store.alarm();
+assert.equal(uncertainCalls,2,'A failed model request has a finite retry limit');
+const ur=uncertain.db.prepare('SELECT spent_micro,status FROM orders WHERE id=?').get(uo.order.id);
+assert.equal(ur.spent_micro,callReservation(readBook(book),0)*2,'Uncertain provider requests keep their full reservation');assert.equal(ur.status,'paused');
